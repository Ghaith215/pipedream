from fastapi import FastAPI, UploadFile, File, Form
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from sqlalchemy import create_engine, Column, Integer, String
from sqlalchemy.ext.declarative import declarative_base
from sqlalchemy.orm import sessionmaker
import shutil, os

Base = declarative_base()
DB_NAME = "alpha.db"
engine = create_engine(f"sqlite:///{DB_NAME}")
SessionLocal = sessionmaker(bind=engine)

class Movie(Base):
    __tablename__ = "movies"
    id = Column(Integer, primary_key=True)
    title = Column(String)
    year = Column(String)
    description = Column(String)
    category = Column(String)
    image = Column(String)
    link = Column(String)
    type = Column(String)

Base.metadata.create_all(bind=engine)

app = FastAPI()
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.get("/movies")
def get_movies():
    db = SessionLocal()
    movies = db.query(Movie).all()
    db.close()
    return [{"id": m.id, "title": m.title, "year": m.year, "description": m.description,
             "category": m.category, "image": m.image, "link": m.link,
             "type": m.type} for m in movies]

@app.post("/add_movie")
def add_movie(title: str = Form(...), year: str = Form(...), description: str = Form(...),
              category: str = Form(...), link: str = Form(...), type: str = Form(...),
              image: UploadFile = File(...)):
    db = SessionLocal()
    os.makedirs("images", exist_ok=True)
    image_path = f"images/{image.filename}"
    with open(image_path, "wb") as buffer:
        shutil.copyfileobj(image.file, buffer)
    movie = Movie(title=title, year=year, description=description,
                  category=category, image=image_path, link=link, type=type)
    db.add(movie)
    db.commit()
    db.close()
    return JSONResponse({"message":"Movie added successfully"})
