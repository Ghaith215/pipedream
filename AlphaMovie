import React, { useEffect, useState } from "react";
import MovieCard from "./components/MovieCard";
import BottomNav from "./components/BottomNav";
import "./App.css";

function App() {
  const [movies, setMovies] = useState([]);
  const [search, setSearch] = useState("");

  useEffect(() => {
    fetch("https://YOUR_RAILWAY_BACKEND_URL/movies") // ضع رابط API بعد رفع Backend
      .then(res => res.json())
      .then(data => setMovies(data));
  }, []);

  const filtered = movies.filter(m => m.title.toLowerCase().includes(search.toLowerCase()));

  return (
    <div className="App">
      <header>AlphaMovie</header>
      <input type="text" placeholder="ابحث عن فيلم أو مسلسل..." value={search} onChange={e=>setSearch(e.target.value)} />
      <div className="movies-container">
        {filtered.length ? filtered.map(movie => <MovieCard key={movie.id} movie={movie} />) : <p>لا توجد أفلام أو مسلسلات</p>}
      </div>
      <BottomNav />
    </div>
  );
}

export default App;
